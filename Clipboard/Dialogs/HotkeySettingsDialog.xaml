<Window x:Class="ClipboardApp.Dialogs.HotkeySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局快捷键设置"
        Height="300" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置用于显示主窗口的全局快捷键"
                   FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="直接按下你想要的快捷键组合，支持 Ctrl、Alt、Shift、Win 等修饰键"
                   Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="快捷键：" VerticalAlignment="Center" FontWeight="Bold" Width="70"/>
            <TextBox x:Name="HotkeyBox"
                     IsReadOnly="True"
                     Height="48"
                     FontSize="16"
                     FontWeight="Bold"
                     VerticalContentAlignment="Center"
                     Padding="12,0"
                     BorderBrush="#4CAF50"
                     BorderThickness="3"
                     Background="White"
                     Foreground="#2E7D32"
                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"/>
        </DockPanel>

        <TextBlock Grid.Row="3" x:Name="PreviewLabel" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="清除快捷键" Padding="12,6" Margin="0,0,0,0"
                    Background="#FF5722" Foreground="White" BorderThickness="0"
                    Click="ClearButton_OnClick"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Height="32" Margin="0,0,8,0" IsDefault="True" Click="OkButton_OnClick"/>
            <Button Content="取消" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
