<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 只产出 Windows x64 原生库（SQLite 等），否则 Debug 构建会把全平台 runtimes 都拷进 bin -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RootNamespace>ClipboardApp</RootNamespace>
    <AssemblyName>Clipboard</AssemblyName>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Company>Fireneb-炎序星图</Company>
    <Product>Clipboard</Product>
    <Copyright>Copyright © 2026 Fireneb-炎序星图</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>ClipboardApp.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标嵌入程序集（pack://application:,,,/Assets/... 访问），不再复制到输出目录 -->
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
